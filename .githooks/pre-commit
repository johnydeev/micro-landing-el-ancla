#!/bin/sh
# Comprime los PNG de ofertas (y el logo) ANTES de que entren al commit.
#
# Por que: el workflow de GitHub Actions ya comprime y commitea, pero ese
# commit lo hace el bot en el remoto, y deja al clon local un commit atras
# en cada imagen nueva. Si la imagen ya entra comprimida, el workflow no
# encuentra nada que hacer y no commitea. El workflow queda como red de
# seguridad (por si este hook no esta instalado en algun clon).
#
# Se activa con `git config core.hooksPath .githooks` — lo hace el script
# "prepare" de package.json al correr `npm install`.

staged=$(git diff --cached --name-only --diff-filter=AM -- 'public/ofertas/*.png' 'public/logo.png')

[ -z "$staged" ] && exit 0

echo "pre-commit: optimizando imagenes staged..."
# shellcheck disable=SC2086
node scripts/optimize-images.mjs $staged || exit 1

# Volver a stagear: si el script reescribio algun archivo, el commit tiene
# que llevar la version comprimida, no la que estaba staged antes.
# shellcheck disable=SC2086
git add -- $staged
