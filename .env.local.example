# ---- Globales ----------------------------------------------------------

# Tenant que se sirve en "/" (la TV de El Ancla apunta a "/").
DEFAULT_TENANT=granja-elancla
# Mismo valor, expuesto al cliente (lo usa app/error.tsx).
NEXT_PUBLIC_DEFAULT_TENANT=granja-elancla

# Cloudinary: cloud name (Dashboard) y carpeta base del catalogo de imagenes.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CATALOGO=catalogo-comun

# Activacion de pantallas (lib/activacion.ts). Secreto largo al azar, el mismo
# en Vercel; si cambia, todas las teles activadas quedan sin activar.
ACTIVACION_SECRET=
# Opcional: contacto que muestra la pantalla bloqueada.
SOPORTE_CONTACTO=
# Estado de teles y cobros (Supabase, proyecto tv-precios). Solo servidor:
# la service role key saltea RLS. En Vercel, Production y como Secret.
# Sin estas dos, las pantallas se muestran igual (sin bloqueos).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Por tenant --------------------------------------------------------
# Una variable por comercio: TENANT_<SLUG_EN_MAYUSCULAS_CON_GUION_BAJO>_CSV_URL
# con la URL del CSV publicado de su planilla (Archivo > Compartir > Publicar
# en la web > CSV). Los GIDs de ofertas y config van en tenants/<slug>.ts.

TENANT_GRANJA_ELANCLA_CSV_URL=

# ---- Solo para `npm run alta` (alta de cliente desde la terminal) --------
# Cloudinary > Settings > API Keys. Vercel > Account > Tokens; el project id
# esta en Vercel > Project > Settings > General. VERCEL_TEAM_ID solo si el
# proyecto esta en un team. Nunca commitear estos valores.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
